# Unified Environment Variables for Barista Microservices

## Core Configuration
PORT=8080
DB_URL=postgres://user:password@host:port/dbname?sslmode=require
REDIS_URL=redis://default:password@host:port
JWT_KEY=your_secret_jwt_key
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.onrender.com

## Inter-Service URLs (gRPC)
AUTH_SERVICE_URL=auth-service:PORT
SHOP_SERVICE_URL=shop-service:PORT
MENU_SERVICE_URL=menu-service:PORT
TABLE_SERVICE_URL=table-service:PORT
SESSION_SERVICE_URL=session-service:PORT
ORDER_SERVICE_URL=order-service:PORT
PAYMENT_SERVICE_URL=payment-service:PORT
HISTORY_SERVICE_URL=history-service:PORT
WEBSOCKET_SERVICE_URL=ws-service:PORT

## RabbitMQ (Defaults for Custom Service)
RMQ_HOST=rabbitmq-service:5672
RMQ_USER_NAME=admin
RMQ_PASSWORD=7866
RMQ_VHOST=barista

## Third-Party
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
